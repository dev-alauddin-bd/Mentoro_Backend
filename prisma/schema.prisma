generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role                   @default(student)
  avatar                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                UserStatus             @default(active)
  phone                 String?
  assignmentSubmissions AssignmentSubmission[]
  courses               Course[]
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  liveSessions          LiveSession[]
  payments              Payment[]
  reviews               Review[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  slug      String   @unique
  courses   Course[]

  @@map("categories")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  description      String?
  thumbnail        String
  previewVideo     String
  price            Float        @default(0)
  isPublished      Boolean      @default(false)
  categoryId       String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  isDeleted        Boolean      @default(false)
  hasCertificate   Boolean      @default(false)
  learningOutcomes String[]     @default([])
  requirements     String[]     @default([])
  tags             String[]     @default([])
  targetAudience   String[]     @default([])
  instructorId     String
  slug             String       @unique
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  instructor       User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  modules          Module[]
  payments         Payment[]
  reviews          Review[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([slug])
  @@index([isPublished])
  @@index([isDeleted])
  @@map("courses")
}

model Module {
  id          String       @id @default(uuid())
  title       String
  courseId    String
  order       Int          @default(0)
  isDeleted   Boolean      @default(false)
  assignments Assignment[]
  lessons     Lesson[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
  @@index([isDeleted])
  @@map("modules")
}

model Lesson {
  id        String           @id @default(uuid())
  title     String
  videoUrl  String
  duration  Float            @default(0)
  moduleId  String
  order     Int              @default(0)
  isDeleted Boolean          @default(false)
  content   String?
  progress  LessonProgress[]
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, order])
  @@index([isDeleted])
  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  lessonId    String
  isCompleted Boolean  @default(false)
  progress    Float    @default(0)
  lastWatched Float    @default(0)
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([courseId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Assignment {
  id          String                 @id @default(uuid())
  description String
  moduleId    String
  createdAt   DateTime               @default(now())
  deadline    DateTime?
  isDeleted   Boolean                @default(false)
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([moduleId, createdAt])
  @@map("assignments")
}

model Enrollment {
  id         String           @id @default(uuid())
  courseId   String
  enrolledAt DateTime         @default(now())
  studentId  String
  amount     Float            @default(0)
  currency   String           @default("usd")
  email      String
  name       String
  phone      String
  status     EnrollmentStatus @default(PENDING)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model Review {
  id        String   @id @default(uuid())
  content   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, rating])
  @@index([studentId])
  @@map("reviews")
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  stripePaymentId String?       @unique
  courseId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  type            PaymentType   @default(COURSE_PURCHASE)
  studentId       String
  enrollId        String?
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment      Enrollment?   @relation(fields: [enrollId], references: [id], onDelete: Cascade)
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([studentId])
  @@index([courseId])
  @@index([enrollId])
  @@index([studentId, courseId])
  @@map("payments")
}

model LiveSession {
  id                   String             @id @default(uuid())
  title                String
  description          String?
  thumbnail            String?
  sessionDate          DateTime
  registrationDeadline DateTime
  maxCapacity          Int?
  meetingLink          String?
  isPublished          Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  keyTopics            String[]           @default([])
  learningOutcomes     String[]           @default([])
  level                String             @default("BEGINNER")
  whoShouldAttend      String[]           @default([])
  userId               String
  registrations        LiveRegistration[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_sessions")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  content      String
  status       String     @default("submitted")
  score        Float?
  assignmentId String
  submittedAt  DateTime   @default(now())
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model LiveRegistration {
  id           String      @id @default(uuid())
  name         String
  email        String
  phone        String
  sessionId    String
  registeredAt DateTime    @default(now())
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([email, sessionId])
  @@map("live_registrations")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String?
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

enum Role {
  student
  instructor
  admin
}

enum UserStatus {
  active
  blocked
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE_PURCHASE
  FEATURED_REQUEST
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  CANCELLED
}
