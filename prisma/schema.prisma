generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role                   @default(student)
  avatar                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                UserStatus             @default(active)
  assignmentSubmissions AssignmentSubmission[]
  completedLessons      CompletedLesson[]
  createdCourses        Course[]               @relation("InstructorCourses")
  enrolledCourses       Enrollment[]
  payments              Payment[]
  reviews               Review[]
  quizSubmissions       QuizSubmission[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]

  @@map("categories")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  description      String?
  thumbnail        String
  previewVideo     String
  price            Float        @default(0)
  instructorId     String
  isPublished      Boolean      @default(false)
  categoryId       String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  isDeleted        Boolean      @default(false)
  learningOutcomes String[]
  requirements    String[]
  targetAudience  String[]
  tags            String[]
  hasCertificate  Boolean @default(false)
  isFree          Boolean @default(false)
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrolledUsers    Enrollment[]
  modules          Module[]
  payments         Payment[]
  reviews          Review[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([isPublished])
  @@index([isDeleted])
  @@map("courses")
}

model Module {
  id          String       @id @default(uuid())
  title       String
  courseId    String
  order       Int          @default(0)
  isDeleted   Boolean      @default(false)
  assignments Assignment[]
  lessons     Lesson[]
  quiz        Quiz?
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([isDeleted])
  @@map("modules")
}

model Review {
  id        String   @id @default(uuid())
  content   String
  rating    Int      @default(5)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([courseId])
  @@index([userId])
  @@map("reviews")
}

model Lesson {
  id               String            @id @default(uuid())
  title            String
  videoUrl         String
  duration         Float             @default(0)
  moduleId         String
  order            Int               @default(0)
  isDeleted        Boolean           @default(false)
  content          String?
  completedByUsers CompletedLesson[]
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([isDeleted])
  @@map("lessons")
}

model Assignment {
  id          String                 @id @default(uuid())
  description String
  moduleId    String
  createdAt   DateTime               @default(now())
  deadline    DateTime?
  isDeleted   Boolean                @default(false)
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("assignments")
}

model Enrollment {
  id           String   @id @default(uuid())
  userId       String
  courseId     String
  enrolledAt   DateTime @default(now())
  lastActivity DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model CompletedLesson {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("completed_lessons")
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  stripePaymentId String?       @unique
  userId          String
  courseId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  type            PaymentType   @default(COURSE_PURCHASE)
  course          Course        @relation(fields: [courseId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([courseId])
  @@map("payments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  content      String
  status       String     @default("submitted")
  score        Float?
  assignmentId String
  userId       String
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
  @@index([userId])
  @@index([assignmentId])
  @@map("assignment_submissions")
}

// ── Quiz (Instructor-created, stored in DB) ───────────────────────────────────
model Quiz {
  id          String         @id @default(uuid())
  moduleId    String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  question      String
  options       String[]
  correctAnswer String
  order         Int      @default(0)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int
  total       Int
  percentage  Float
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([quizId])
  @@index([userId])
  @@map("quiz_submissions")
}

model LiveSession {
  id                   String             @id @default(uuid())
  title                String
  description          String?
  thumbnail            String?
  sessionDate          DateTime
  registrationDeadline DateTime
  maxCapacity          Int?
  meetingLink          String?
  isPublished          Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  registrations        LiveRegistration[]

  @@map("live_sessions")
}

model LiveRegistration {
  id           String      @id @default(uuid())
  name         String
  email        String
  phone        String
  sessionId    String
  registeredAt DateTime    @default(now())
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([email, sessionId])
  @@map("live_registrations")
}

model Job {
  id           String           @id @default(uuid())
  title        String
  category     String
  location     String
  type         String
  salary       String
  description  String
  deadline     DateTime?
  isPublished  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([category])
  @@index([type])
  @@index([isPublished])
  @@map("jobs")
}

model JobApplication {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  resumeLink  String
  coverLetter String?
  status      String   @default("pending")
  jobId       String
  appliedAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model LegalDocument {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_documents")
}

enum Role {
  student
  instructor
  admin
}

enum UserStatus {
  active
  blocked
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE_PURCHASE
  FEATURED_REQUEST
}
